{
  "name": "dsh-fengge-distill",
  "description": "DSH skill provider for the FengGe (峰哥亡命天涯) style-distillation engine: writes sharp takes in the distilled 峰哥体 voice from 1,921 public posts spanning 18 months (with a pre/post-ban era-evolution reference) plus 4,163 high-liked comments, as a style register — never an impersonation.",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "test",
    "scripts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "style-engine.md",
    "corpus.md",
    "evolution.md",
    "data",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.1.0-rc.6 <0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MincongZhou/fengge-distill.git"
  },
  "homepage": "https://github.com/MincongZhou/fengge-distill",
  "bugs": {
    "url": "https://github.com/MincongZhou/fengge-distill/issues"
  },
  "scripts": {
    "test": "node --test",
    "verify": "node scripts/verify-provider.mjs",
    "check": "node --test && node scripts/verify-provider.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "skills",
    "skill-provider",
    "style-distillation",
    "fengge",
    "writing"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.0.1-rc.1": "incompatible",
        "0.0.1-rc.2": "incompatible",
        "0.0.1-rc.5": "incompatible",
        "0.1.0-rc.2": "incompatible",
        "0.1.0-rc.3": "incompatible",
        "0.1.0-rc.6": "compatible",
        "0.1.0-rc.7": "compatible",
        "0.1.0-rc.8": "compatible",
        "0.1.1-rc.1": "compatible",
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.2": "compatible",
        "0.1.2-alpha.3": "compatible",
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.2": "compatible",
        "0.1.5-alpha.1": "compatible",
        "0.1.5-alpha.2": "compatible",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible"
      }
    }
  }
}
